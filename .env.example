# Database Configuration (SQLite default; can also use PostgreSQL or MySQL)
DATABASE_URL=sqlite:///./archintx.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://archintx_user:secretpassword@localhost:5432/archintx_db
# MySQL Example:
# DATABASE_URL=mysql+pymysql://archintx_user:secretpassword@localhost:3306/archintx_db

# JWT Security
SECRET_KEY=archintx-production-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Inactivity Threshold (Days)
INACTIVE_THRESHOLD_DAYS=7
LOW_SCORE_THRESHOLD=60.0

# Server Host & Port
HOST=127.0.0.1
PORT=8000
